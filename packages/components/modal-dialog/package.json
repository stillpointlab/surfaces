{
  "name": "@stillpointlab/modal-dialog-component",
  "version": "0.1.0",
  "description": "The <modal-dialog> element Stillpoint Lab surfaces share: scrim, focus trap, Escape to close, and header, body and footer slots.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./src/index.ts",
    "./src/modal-dialog.ts",
    "./dist/index.js",
    "./dist/index.cjs"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "gen:styles": "node ../../../tooling/gen-styles.mjs .",
    "build": "npm run gen:styles && tsup",
    "dev": "npm run gen:styles && vite --config ../../../tooling/harness/vite.config.ts",
    "typecheck": "npm run gen:styles && tsc --noEmit",
    "test": "npm run gen:styles && vitest run"
  },
  "dependencies": {
    "@stillpointlab/common-format": "*"
  }
}
