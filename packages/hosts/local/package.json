{
  "name": "@stillpointlab/local-host",
  "version": "0.1.0",
  "private": true,
  "description": "The local host: a server over a folder that opens its files in their formats and mounts its apps, with nothing from Context Manager.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "surfaces": "./bin/surfaces.js"
  },
  "exports": {
    ".": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    }
  },
  "scripts": {
    "gen:styles": "node ../../../tooling/gen-styles.mjs",
    "build": "npm run gen:styles && npm run build:server && npm run build:client",
    "build:server": "tsup",
    "build:client": "vite build",
    "typecheck": "npm run gen:styles && tsc --noEmit && tsc --noEmit -p tsconfig.client.json",
    "test": "npm run gen:styles && vitest run --passWithNoTests"
  },
  "dependencies": {
    "@stillpointlab/code-format": "*",
    "@stillpointlab/common-format": "*",
    "@stillpointlab/image-format": "*",
    "@stillpointlab/md-format": "*",
    "@stillpointlab/modal-dialog-component": "*",
    "@stillpointlab/sheet-format": "*",
    "@stillpointlab/spl-icon-component": "*",
    "@stillpointlab/xmdl-format": "*",
    "dompurify": "^3.4.17"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  }
}
