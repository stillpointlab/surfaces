{
  "extends": "../../../tsconfig.base.json",
  // The core is DOM-free: no DOM lib, so a stray `document` or `HTMLElement`
  // fails the typecheck. The element has its own config (tsconfig.element.json).
  "compilerOptions": {
    "lib": ["ES2022"]
  },
  "include": ["src"],
  "exclude": ["src/element"]
}
