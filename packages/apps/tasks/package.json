{
  "name": "@stillpointlab/tasks-app",
  "version": "0.1.0",
  "description": "The tasks app's DOM-free core: the tasks.yaml manifest, board and pool detection, card frontmatter and projections, and byte-preserving rewrites of the manifest and cards.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./src/element/index.ts",
    "./src/element/task-board.ts",
    "./src/element/tasks-nav.ts",
    "./dist/element.js",
    "./dist/element.cjs"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.cjs"
    },
    "./paths": {
      "types": "./dist/paths.d.ts",
      "import": "./dist/paths.js",
      "require": "./dist/paths.cjs"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js",
      "require": "./dist/element.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "gen:styles": "node ../../../tooling/gen-styles.mjs .",
    "build": "npm run gen:styles && tsup",
    "dev": "npm run gen:styles && vite --config ../../../tooling/harness/vite.config.ts",
    "typecheck": "npm run gen:styles && tsc --noEmit && tsc --noEmit -p tsconfig.element.json",
    "test": "npm run gen:styles && vitest run"
  },
  "dependencies": {
    "@stillpointlab/common-format": "*",
    "@stillpointlab/modal-dialog-component": "*",
    "yaml": "^2.9.0",
    "zod": "^4.6.7"
  }
}
