{
  "name": "@stillpointlab/inventory-app",
  "version": "0.1.0",
  "description": "The inventory app's DOM-free core: the inventory.yaml manifest and Zone files, parsed, validated, totalled, rewritten byte-preservingly and exported as CSV, plus the overview and zone elements.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./src/element/index.ts",
    "./src/element/inventory-overview.ts",
    "./src/element/inventory-zone.ts",
    "./dist/element.js",
    "./dist/element.cjs"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.cjs"
    },
    "./paths": {
      "types": "./dist/paths.d.ts",
      "import": "./dist/paths.js",
      "require": "./dist/paths.cjs"
    },
    "./create": {
      "types": "./dist/create.d.ts",
      "import": "./dist/create.js",
      "require": "./dist/create.cjs"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js",
      "require": "./dist/element.cjs"
    },
    "./create-element": {
      "types": "./dist/create-element.d.ts",
      "import": "./dist/create-element.js",
      "require": "./dist/create-element.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "gen:styles": "node ../../../tooling/gen-styles.mjs .",
    "build": "npm run gen:styles && tsup",
    "dev": "npm run gen:styles && vite --config ../../../tooling/harness/vite.config.ts",
    "typecheck": "npm run gen:styles && tsc --noEmit && tsc --noEmit -p tsconfig.element.json",
    "test": "npm run gen:styles && vitest run"
  },
  "dependencies": {
    "@stillpointlab/common-format": "*",
    "@stillpointlab/modal-dialog-component": "*",
    "@stillpointlab/sheet-format": "*",
    "yaml": "^2.9.0",
    "zod": "^4.6.7"
  }
}
