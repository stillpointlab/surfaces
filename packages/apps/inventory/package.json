{
  "name": "@stillpointlab/inventory-app",
  "version": "0.1.0",
  "description": "The inventory app's DOM-free core: the inventory.yaml manifest and Zone files, parsed, validated, totalled, rewritten byte-preservingly and exported as CSV.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./paths": {
      "types": "./dist/paths.d.ts",
      "import": "./dist/paths.js",
      "require": "./dist/paths.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@stillpointlab/common-format": "*",
    "@stillpointlab/sheet-format": "*",
    "yaml": "^2.9.0",
    "zod": "^4.6.7"
  }
}
