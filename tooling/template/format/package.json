{
  "name": "@stillpointlab/sample-format",
  "version": "0.1.0",
  "description": "A Stillpoint Lab format: a <sample-preview> and a <sample-editor> over one good.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./src/preview/index.ts",
    "./src/preview/sample-preview.ts",
    "./src/editor/index.ts",
    "./src/editor/sample-editor.ts",
    "./dist/preview.js",
    "./dist/preview.cjs",
    "./dist/editor.js",
    "./dist/editor.cjs"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./preview": {
      "types": "./dist/preview.d.ts",
      "import": "./dist/preview.js",
      "require": "./dist/preview.cjs"
    },
    "./editor": {
      "types": "./dist/editor.d.ts",
      "import": "./dist/editor.js",
      "require": "./dist/editor.cjs"
    }
  },
  "files": [
    "dist",
    "preview.d.ts",
    "editor.d.ts"
  ],
  "scripts": {
    "gen:styles": "node ../../../tooling/gen-styles.mjs .",
    "build": "npm run gen:styles && tsup",
    "dev": "npm run gen:styles && vite --config ../../../tooling/harness/vite.config.ts",
    "typecheck": "npm run gen:styles && tsc --noEmit",
    "test": "npm run gen:styles && vitest run"
  },
  "dependencies": {
    "@stillpointlab/common-format": "*"
  }
}
