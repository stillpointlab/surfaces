{
  "extends": "../tsconfig.base.json",
  // The tooling's own TypeScript, tests included, run in Node. The `.mjs` scripts
  // they import are read, and checked, by their JSDoc types. The harness has its
  // own config (harness/tsconfig.json).
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": true
  },
  "include": ["*.ts"]
}
